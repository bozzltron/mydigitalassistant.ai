{
    admin off
    grace_period 1s
}

https://localhost {
    tls /etc/caddy/certs/localhost.crt /etc/caddy/certs/localhost.key
    
    # Prevent caching of index.html so SPA always loads fresh
    @html path /index.html
    header @html Cache-Control "no-cache, no-store, must-revalidate"
    header @html Pragma "no-cache"
    header @html Expires "0"

    # Aggressive caching for hashed assets (immutable)
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Route all requests to backend (handles both API and SPA)
    reverse_proxy assistant:8000 {
        transport http {
            response_header_timeout 300s
        }
    }
}