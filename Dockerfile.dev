# Use Node.js as base image for the dev environment
FROM node:22-alpine

# Set working directory
WORKDIR /app/frontend

# Copy package files first (for better caching)
COPY frontend/package*.json ./

# Install dependencies
RUN npm install

# Install rollup native module for linux-arm64-musl (npm optional dependency bug)
RUN npm install @rollup/rollup-linux-arm64-musl --save-optional 2>/dev/null || true

# Copy frontend code (after installing deps to avoid reinstalling on code change)
COPY frontend/ .

# Expose port 5173 for Vite dev server 
EXPOSE 5173

# Start the dev server with proper host binding
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]