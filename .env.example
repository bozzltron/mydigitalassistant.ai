# Ollama configuration (local only)
# Model fleet (Phase 6): roles are wired in code; swap models here per plan milestones.
# Working fleet: CHAT=qwen3.5:9b UTILITY=qwen3.5:4b TOOLS=qwen3.5:9b EMBEDDING=qwen3-embedding:0.6b
# Escalation tier: MAX=qwen3.8:27b (auto by reasoner or explicit "Max" UI toggle)
OLLAMA_URL=http://127.0.0.1:11434
# Seconds to wait for local inference before giving up. Large local models
# (27B) with long prompts can take minutes; 600 is a sane default.
# OLLAMA_TIMEOUT=600
# How long Ollama keeps a model loaded between requests (sent per request).
# Default "-1" = never unload: chat + utility stay warm side-by-side so
# alternating roles cost ~0 latency (Option A residency). For this to hold,
# the HOST Ollama daemon also needs:
#   OLLAMA_KEEP_ALIVE=-1
#   OLLAMA_MAX_LOADED_MODELS=4   (warm chat+utility+embedding, room for the
#                                 on-demand 27B max tier; never less than 3)
# Note the max tier is on-demand (MAX_KEEP_ALIVE=10m), so it evicts itself.
# OLLAMA_KEEP_ALIVE=-1

# Dedicated tools model for fast function calling (Phase: Performance)
# Tool calling drives the whole turn (tool calls + final answer) in one loop by
# default; qwen3.5:9b matches the chat model so the controlled nervous system
# and the generator share weights/hot KV reuse.
TOOLS_MODEL=qwen3.5:9b
# Only used when TOOLS_MODEL differs from CHAT_MODEL — the two share one loaded
# runner (and therefore one context window) when they are the same model. Kept
# at the chat value so a distinct tools model still has generation headroom.
TOOLS_NUM_CTX=16384
TOOLS_KEEP_ALIVE=-1

# Streaming responses (SSE) - enabled by default
# STREAMING_ENABLED=true

# SearXNG instance secret. REQUIRED — `docker compose up` refuses to start
# without it. Compose cannot generate this for you (shell substitution inside
# ${VAR:-default} is not executed), so generate it once and paste it here:
#   openssl rand -base64 32
SEARXNG_SECRET=
CHAT_MODEL=qwen3.5:9b
# Extraction + task-routing fallback. qwen3.5:4b is the working default;
# qwen2.5:3b is NOT available in Ollama.
UTILITY_MODEL=qwen3.5:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Reserved role (Phase 6 M5). Empty = chat model handles codegen.
CODER_MODEL=

# Max-intelligence escalation tier (Phase 6 M6). The 27B brain used when the
# reasoner auto-escalates (hard multi-step query, no memory) or the user turns
# on the "Max" toggle in the UI. Loaded on demand with a short keep_alive so it
# never stays resident next to the warm chat/utility/embedding set. Empty =
# escalation falls back to thinking-mode on the chat model.
# MAX_MODEL=qwen3.8:27b
# MAX_NUM_CTX=16384
# MAX_KEEP_ALIVE=10m

# Math/computation model. Empty = math computation disabled (the "compute"
# tool is dropped and math prompts use the normal chat path). OFF by default:
# opt-in models here are loaded ON DEMAND and a 30B-class model (qwen3-coder:30b)
# competes with chat + utility + embedding for host RAM and can wedge the
# Ollama scheduler. If you do opt in, keep MATH_NUM_CTX modest so it loads
# alongside the always-warm set, and consider OLLAMA_MAX_LOADED_MODELS on the host.
# Recommended: reuse the max tier (MATH_MODEL=qwen3.8:27b) — it shares weights
# with MAX_MODEL, so compute adds no extra resident RAM beyond the on-demand 27B.
# MATH_MODEL=
# MATH_NUM_CTX=16384
# MATH_KEEP_ALIVE=10m

# Thinking-mode plumbing (Phase 6 M4 wires escalation policy)
CHAT_THINK_DEFAULT=false
# Cap covers thinking + answer combined. Raise it if long answers on
# escalated (thinking) turns still look truncated.
THINK_NUM_PREDICT_CAP=4096

# Context window for the chat/tools model. The tool loop sends the system
# prompt + every tool schema + conversation history, so this must leave room to
# generate. If replies cut off or the assistant says its context filled up,
# raise CHAT_NUM_CTX (16384 -> 24576). Note: larger windows use more VRAM.
# The backend pins per-request num_ctx (this value) and overrides the host
# daemon's OLLAMA_CONTEXT_LENGTH — so the Mac desktop app setting is cosmetic
# for this assistant. Set it to match anyway to keep non-assistant Ollama usage
# sane, plus OLLAMA_MAX_LOADED_MODELS=4.
CHAT_NUM_CTX=16384

# Native tool-calling on the chat model (Phase 6 M5). Enables list_files,
# read_file, write_file, edit_file, delete_file, glob, recall, web_search,
# fetch_url, and other tools.
TOOLS_ENABLED=true

# File sandbox settings (Phase: File Sandbox Tools)
# SANDBOX_MAX_FILE_SIZE=10000000    # 10MB max write
# SANDBOX_MAX_READ_SIZE=1000000     # 1MB max read
# SANDBOX_MAX_GLOB_RESULTS=1000     # max glob results
# CSV_MAX_ROW_FRAMES=100            # max per-row memory frames for CSV uploads/writes;
                                   # larger CSVs keep row_count/columns metadata only
# FILE_MAX_ENTITY_SLOTS=50          # max entity_* slots stored on an uploaded file frame
                                   # (large CSVs/JSON would otherwise dump one per unique cell)

# Backend configuration (bare-metal runs; Docker binds are set in compose)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Fallback display name until an identity name is learned in conversation.
# ASSISTANT_NAME=Cognitive Assistant

# Database (the agent's brain)
DATABASE_PATH=./assistant.db
# DB_KEY: encryption key for SQLCipher (AES-256). Optional — if unset, the
# database is stored unencrypted. To enable: generate a strong random key and
# put it here. Example: openssl rand -hex 32
# DB_KEY=

# Web search (privacy-first, local SearXNG - always enabled)
SEARCH_BASE_URL=http://127.0.0.1:8080
SEARCH_TIMEOUT=30

# Retrieval tuning
# Max vector distance for direct candidate frames (sqlite-vec cosine, 0-2).
# Lower = stricter similarity.
# RETRIEVAL_MIN_DISTANCE=0.7
# Max past-conversation turns injected per turn via semantic episode recall
# (owner-scoped, current session excluded). 0 disables episode recall.
RETRIEVAL_EPISODE_LIMIT=5

# Canonical frame resolution (Phase 9): max embedding distance at which a
# near-duplicate name reuses an existing frame instead of creating one.
# Lower = fewer merges (conservative default).
# CANONICAL_NAME_DISTANCE=0.10

# Voice transcription (optional - for hands-free chat mode)
# WHISPER_MODEL=base  (try "small" if base is insufficient)
# WHISPER_DEVICE=cpu  (or "cuda" if GPU available)
# WHISPER_DOWNLOAD_ROOT=/app/.cache/whisper  (model cache dir)
# WHISPER_LANGUAGE=en  (ISO code; empty = auto-detect)

# Working memory (LRU cache for retrieval bias)
# WORKING_MEMORY_MAX_SIZE=50   (max entries; evict LRU when full)
# WORKING_MEMORY_BOOST=1.5     (relevance multiplier for recently-accessed frames)

# Scheduled tasks — the daily list (background task inside the backend).
# Enabled by default. Set to false only if you do not want the agent to run
# scheduled tasks.
# SCHEDULER_ENABLED=true
# The agent wakes once a day and runs every "daily" task; "once" tasks run at
# the next tick and disable themselves.
# DAILY_TASKS_TIME=09:00            (HH:MM, 24h)
# DAILY_TASKS_TZ=America/Chicago    (IANA zone; empty = TZ or host-local)
#
# TZ is passed through to the backend container. NOTE: inside Docker an unset/
# empty TZ means UTC (there is no /etc/localtime mount) — set it explicitly so
# "9am" means YOUR morning:
# TZ=America/Chicago

# TLS verification (defense-in-depth for local services)
# If Ollama uses a self-signed TLS cert, set the CA cert path:
# OLLAMA_TLS_CERT=/path/to/ca.pem

# Memory consolidation ("dreaming"): merges near-duplicate frames as soon as
# they appear. Losers are tombstoned but their slots are unioned onto the
# survivor first. Runs every CONSOLIDATION_INTERVAL_HOURS (0 disables) and
# refuses to apply more than CONSOLIDATION_MAX_MERGES_PER_RUN merges per pass
# (logged for manual review instead).
# CONSOLIDATION_INTERVAL_HOURS=6
# CONSOLIDATION_MAX_MERGES_PER_RUN=10

# Embedding top-up: re-indexes turns and frames whose embeddings are missing or
# stale. Cheap, non-destructive, no backup — kept separate from consolidation so
# it can run often without dragging a snapshot along. 0 disables the timer.
# EMBEDDING_TOPUP_INTERVAL_HOURS=6

# Periodic brain snapshot, on its own clock. Merges do not take their own
# backups; this is what protects them. A merge pass that runs without a fresh
# snapshot takes one first, so a merge is never applied unprotected.
# BACKUP_INTERVAL_HOURS=12

# There is no decay or age-based garbage collection: memory only leaves through
# an explicit forget, or a deliberate frame/file deletion. Nothing is forgotten
# on a timer.

# Search result quality (hardening): safesearch 0=off..2=strict (SearXNG
# scale), search_language pins results to a locale, search_min_relevance is
# the cosine-similarity floor between query and a result's title+snippet —
# results below it are dropped before entering the prompt.
# SEARCH_LANGUAGE=en
# SEARCH_SAFESEARCH=1
# SEARCH_MIN_RELEVANCE=0.30

# ---------------------------------------------------------------------------
# Optional cloud search backend: Brave Search API
# ---------------------------------------------------------------------------
# By default the assistant uses the local SearXNG instance above and no query
# leaves your machine. You may optionally enable Brave Search, a privacy-
# respecting cloud backend (https://brave.com/search/api/).
#
# When enabled, sanitized query text and your IP address are sent to Brave's
# servers. Brave does not build a user profile or sell query data. No other
# cloud search providers are permitted.
#
# Both settings are required to activate Brave; BRAVE_API_KEY alone does nothing.
# BRAVE_ENABLED=false
# BRAVE_API_KEY=your_brave_api_key_here
