# Ollama configuration (local only)
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:7b
UTILITY_MODEL=qwen2.5:3b
REASONING_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text

# Backend configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database (the agent's brain)
DATABASE_PATH=./assistant.db

# Confidence tuning
CONFLICT_AUTO_RESOLVE=true

# Web search (privacy-first, local SearXNG - always enabled)
SEARCH_BASE_URL=http://127.0.0.1:8080
SEARCH_TIMEOUT=30

# Voice transcription (optional - for hands-free chat mode)
# WHISPER_MODEL=base  (try "small" if base is insufficient)
# WHISPER_DEVICE=cpu  (or "cuda" if GPU available)
