{
    admin off
    grace_period 1s
}

https://localhost {
    tls /etc/caddy/certs/localhost.crt /etc/caddy/certs/localhost.key
    
    # Route API requests to backend
    @api path /api/* /health
    reverse_proxy @api assistant:8000 {
        transport http {
            response_header_timeout 300s
        }
    }
    
    # Route all other requests to frontend dev server
    reverse_proxy solid-dev-server:3000 {
        transport http {
            response_header_timeout 300s
        }
    }
}
