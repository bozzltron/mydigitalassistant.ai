# ============================================================
# Cognitive Digital Assistant — Root .gitignore
# ============================================================

# ----- Secrets & environment -----
.env
.env.*
!.env.example
*.pem
*.key

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/
.installed.cfg
*.egg-link

# ----- Virtual environments -----
.venv/
venv/
env/
ENV/

# ----- Tooling caches -----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/

# ----- Project data (the agent's brain) -----
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
assistant.db
assistant-data/

# ----- Backups -----
*.tar.gz
*.zip
brain-backups/
backups/
tmp/
temp/

# ----- Docker -----
Dockerfile.*.bak
docker-compose.override.yml

# Caddy auto-generated certs (keep local)
.data/caddy/

# Host-visible file sandbox (bind-mounted at /app/data when SANDBOX_DIR points
# here). Defaults now live in ~/Documents/Agent/{Dev,Production}; these entries
# keep a repo-relative SANDBOX_DIR (or a pre-existing install) untracked.
.data/shared/
.data/shared-dev/

# ----- IDE & editor -----
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Logs -----
*.log
logs/

# ----- OS -----
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini
assistant.db.unencrypted.backup

eval_results/
data/
*.assistant-brain

# Built frontend bundle (Vite writes here; rebuilt in the Docker image).
# icons.svg / trash.svg stay tracked -- they are hand-maintained and served at
# runtime, and Vite cannot empty a directory outside its own root.
assistant/backend/static/assets/
assistant/backend/static/index.html

# ----- Agent runs -----
# A run directory is working state, like /plans/. The measurement log is the
# durable record and stays tracked; the handoffs and log snapshots do not.
.agents/runs/*
!.agents/runs/log.jsonl

# ----- Plans -----
# Plans are working state (RUNBOOK §3-4): they are deleted when the work ships,
# and git history is the archive. A plan that is not finished stays on disk here.
plans/

# The one list that must never be committed: values pii-guard blocks.
.agents/pii-denylist.txt
