# ============================================================
# Cognitive Digital Assistant — Root .gitignore
# ============================================================

# ----- Secrets & environment -----
.env
.env.*
!.env.example
*.pem
*.key

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/
.installed.cfg
*.egg-link

# ----- Virtual environments -----
.venv/
venv/
env/
ENV/

# ----- Tooling caches -----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/

# ----- Project data (the agent's brain) -----
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
assistant.db
assistant-data/

# ----- Backups -----
*.tar.gz
*.zip
brain-backups/
backups/
tmp/
temp/

# ----- Docker -----
Dockerfile.*.bak
docker-compose.override.yml

# Caddy auto-generated certs (keep local)
.data/caddy/

# ----- IDE & editor -----
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Logs -----
*.log
logs/

# ----- OS -----
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini
assistant.db.unencrypted.backup

eval_results/
data/
