#!/bin/bash

# Run the assistant CLI against the backend already running in docker compose.
# Usage: ./assistant/bin/assistant <cli-command> [args...]
# Example: ./assistant/bin/assistant chat

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

docker compose -f "$REPO_ROOT/docker-compose.yml" exec -T assistant \
    python -m assistant.cli.app "$@"
