#!/usr/bin/env bash
# Wrapper to run the assistant CLI in Docker.
# Usage: ./bin/assistant <command> [args...]
# Example: ./bin/assistant chat
# Example: ./bin/assistant memory list

set -euo pipefail

# Find the repo root (parent of assistant/)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$(dirname "$SCRIPT_DIR")")"
COMPOSE_DIR="$REPO_ROOT"

# Ensure the backend is running
BACKEND_STATUS=$(docker compose -f "$COMPOSE_DIR/docker-compose.yml" ps assistant 2>&1)
if echo "$BACKEND_STATUS" | grep -q "Up"; then
    echo "Backend already running."
else
    echo "Backend not running. Starting it..."
    docker compose -f "$COMPOSE_DIR/docker-compose.yml" up -d --remove-orphans assistant
    sleep 3
fi

# Run the CLI command in the cli container with TTY for interactive chat
docker compose -f "$COMPOSE_DIR/docker-compose.yml" \
    --profile cli run --rm cli "$@"
